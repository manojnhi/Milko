{
  "expo": {
    "name": "Milko",
    "slug": "milko",
    "version": "2.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.milko.app",
      "versionCode": 2
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Milko needs the camera to take a milkman's photo.",
          "photosPermission": "Milko needs access to photos to choose a milkman's photo or business logo.",
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
